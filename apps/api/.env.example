# ============ SERVER ============
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://employee-manager-pi-one.vercel.app
ALLOWED_ORIGINS=https://employee-manager-pi-one.vercel.app,http://localhost:3000
MFA_ENCRYPTION_KEY=CHANGE_ME

# ============ DATABASE ============
MONGODB_URI=YOUR_MONGODB_URI_HERE

# ============ JWT ============
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============ EMAIL ============
# Leave EMAIL_HOST blank to use Ethereal test mode
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=TBI Platform <noreply@tbi.org>

# ============ SECURITY ============
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
