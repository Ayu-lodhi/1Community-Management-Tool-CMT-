# ============ SERVER (Local Development Defaults) ============
# For production deployment environment settings, see docs/DEPLOYMENT.md
NODE_ENV=development
PORT=5000
TRUST_PROXY=false # Set to true or hop count (e.g. 1) behind ALB, Cloudflare, Nginx, or Vercel to prevent shared IP rate limit lockouts
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MFA_ENCRYPTION_KEY=

# ============ DATABASE ============
MONGODB_URI=mongodb://localhost:27017/tbi_platform?replicaSet=rs0

# ============ REDIS ============
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6380/1
REDIS_QUEUE_URL=redis://localhost:6381/2

# ============ JWT ============
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============ EMAIL & AWS SES ============
# Option A: Standard AWS SES via IAM credentials
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@tbigeu.tech
SES_FROM_NAME="TBI-GEU"
SES_CONFIGURATION_SET=my-first-configuration-set

# Option B: Direct SMTP settings
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TBI-GEU" <noreply@tbigeu.tech>

# Prefix for auto-generated sequential User IDs (default: TBI)
USER_ID_PREFIX=TBI

# ============ SECURITY ============
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
ENFORCE_MFA=false
CAPTCHA_ENABLED=false
