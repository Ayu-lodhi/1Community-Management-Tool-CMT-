# API Base URL (leave empty for same-origin proxy in development)
VITE_API_BASE_URL=

# Google reCAPTCHA v2 site key (optional for local dev)
VITE_RECAPTCHA_SITE_KEY=

# WARNING: NEVER set VITE_DEMO_* variables in production deployments!
# Demo credentials are for local development only and are tree-shaken when unset.
# VITE_DEMO_SUPER_EMAIL=
# VITE_DEMO_SUPER_PASSWORD=
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_T3_EMAIL=
# VITE_DEMO_T3_PASSWORD=
# VITE_DEMO_T2_EMAIL=
# VITE_DEMO_T2_PASSWORD=
# VITE_DEMO_T1_EMAIL=
# VITE_DEMO_T1_PASSWORD=
