# API Base URL (leave empty for same-origin proxy in development)
VITE_API_BASE_URL=

# Google reCAPTCHA v2 site key (optional for local dev)
VITE_RECAPTCHA_SITE_KEY=

# Local development demo credentials (set in gitignored .env.local; never commit real credentials)
VITE_DEMO_SUPER_EMAIL=CHANGE_ME
VITE_DEMO_SUPER_PASSWORD=CHANGE_ME
VITE_DEMO_ADMIN_EMAIL=CHANGE_ME
VITE_DEMO_ADMIN_PASSWORD=CHANGE_ME
VITE_DEMO_T3_EMAIL=CHANGE_ME
VITE_DEMO_T3_PASSWORD=CHANGE_ME
VITE_DEMO_T2_EMAIL=CHANGE_ME
VITE_DEMO_T2_PASSWORD=CHANGE_ME
VITE_DEMO_T1_EMAIL=CHANGE_ME
VITE_DEMO_T1_PASSWORD=CHANGE_ME
