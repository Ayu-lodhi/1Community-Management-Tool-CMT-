# ==============================================================================
# CMT Web App & Serverless Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED (Backend serverless /api function)
# ------------------------------------------------------------------------------
# MongoDB connection string (Atlas URI or replica set)
MONGODB_URI=CHANGE_ME

# Cryptographic secret for signing JWT access tokens (minimum 32 characters)
JWT_ACCESS_SECRET=CHANGE_ME

# Cryptographic secret for signing JWT refresh tokens (minimum 32 characters, must differ from access secret)
JWT_REFRESH_SECRET=CHANGE_ME

# ------------------------------------------------------------------------------
# RECOMMENDED
# ------------------------------------------------------------------------------
# Runtime environment ('production' for deployment, 'development' for local)
NODE_ENV=production

# Public canonical frontend URL (used for CORS and link generation)
CLIENT_URL=CHANGE_ME

# Comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=CHANGE_ME

# SMTP server hostname for system email delivery (e.g. email-smtp.ap-south-1.amazonaws.com for AWS SES)
EMAIL_HOST=CHANGE_ME

# SMTP port (typically 587 for STARTTLS or 465 for TLS)
EMAIL_PORT=587

# SMTP authentication username (SES SMTP Access Key ID, e.g. AKIA...)
EMAIL_USER=CHANGE_ME

# SMTP authentication password (derived SES SMTP password)
EMAIL_PASS=CHANGE_ME

# Sender email address displayed on system emails (must match verified SES domain or identity)
EMAIL_FROM=CHANGE_ME

# Prefix for auto-generated sequential User IDs (default: TBI -> TBI00001)
USER_ID_PREFIX=TBI

# ------------------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------------------
# Access token expiry duration (default: 15m)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiry duration (default: 7d)
JWT_REFRESH_EXPIRY=7d

# Enforce MFA for privileged administrative roles ('true' or 'false')
ENFORCE_MFA=false

# 64-character hex key (32 bytes) used to encrypt TOTP secrets in database
MFA_ENCRYPTION_KEY=CHANGE_ME

# Enable reCAPTCHA verification on login ('true' or 'false')
CAPTCHA_ENABLED=false

# Google reCAPTCHA v2 secret key for server-side verification
RECAPTCHA_SECRET_KEY=CHANGE_ME

# Inactivity timeout for active user sessions in minutes
SESSION_TIMEOUT_MINUTES=60

# Distributed Redis cache endpoint (optional; in-memory fallback used if unset)
REDIS_CACHE_URL=CHANGE_ME

# ------------------------------------------------------------------------------
# FRONTEND / VITE SETTINGS (Client-side)
# ------------------------------------------------------------------------------
# Base URL for API requests (leave empty on Vercel to use relative /api rewrites)
VITE_API_BASE_URL=

# Google reCAPTCHA v2 public site key for login page
VITE_RECAPTCHA_SITE_KEY=

# WARNING: NEVER set VITE_DEMO_* variables in production deployments!
# Demo credentials are for local development only and are tree-shaken when unset.
# VITE_DEMO_SUPER_EMAIL=
# VITE_DEMO_SUPER_PASSWORD=
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_T3_EMAIL=
# VITE_DEMO_T3_PASSWORD=
# VITE_DEMO_T2_EMAIL=
# VITE_DEMO_T2_PASSWORD=
# VITE_DEMO_T1_EMAIL=
# VITE_DEMO_T1_PASSWORD=
