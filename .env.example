# Environment Configuration Example
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas / Local URI
MONGODB_URI=mongodb://localhost:27017/tbi_platform?replicaSet=rs0

# Redis Configurations (Isolated 3 Concerns)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6380/1
REDIS_QUEUE_URL=redis://localhost:6381/2

# JWT Security
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MFA TOTP
# Generate 32 random bytes encoded as 64 hex characters; keep outside the database.
MFA_ENCRYPTION_KEY=
MFA_APP_NAME="TBI Platform"

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_CERTIFICATES_BUCKET=tbi-certificates-dev
AWS_SES_SENDER_EMAIL=noreply@tbi.ac.in

# SMS Providers
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_dummy_account_sid
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google reCAPTCHA v2
# Get keys at https://www.google.com/recaptcha/admin/create (choose "Challenge (v2)" > "I'm not a robot")
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
# Set to 'false' to disable CAPTCHA (useful for automated tests / local dev)
CAPTCHA_ENABLED=true
