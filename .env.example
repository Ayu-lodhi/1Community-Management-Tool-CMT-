# ==============================================================================
# Environment Configuration (Local Development Defaults)
# For production deployment environment settings, see docs/DEPLOYMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED
# ------------------------------------------------------------------------------
# MongoDB connection string (Atlas URI or replica set)
MONGODB_URI=mongodb://localhost:27017/tbi_platform?replicaSet=rs0

# Cryptographic secret for signing JWT access tokens (minimum 32 characters)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars

# Cryptographic secret for signing JWT refresh tokens (minimum 32 characters, must differ from access secret)
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars

# ------------------------------------------------------------------------------
# RECOMMENDED
# ------------------------------------------------------------------------------
# Runtime environment ('production' for deployment, 'development' for local)
NODE_ENV=development

# Public canonical frontend URL (used for CORS and link generation)
CLIENT_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP server hostname for system email delivery (e.g. email-smtp.ap-south-1.amazonaws.com for AWS SES)
EMAIL_HOST=

# SMTP port (typically 587 for STARTTLS or 465 for TLS)
EMAIL_PORT=587

# SMTP authentication username
EMAIL_USER=

# SMTP authentication password
EMAIL_PASS=

# Sender email address displayed on system emails
EMAIL_FROM=TBI Platform <noreply@tbi.ac.in>

# Prefix for auto-generated sequential User IDs (default: TBI -> TBI00001)
USER_ID_PREFIX=TBI

# ------------------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------------------
# HTTP port for standalone server mode (ignored on Vercel serverless)
PORT=5000

# Access token expiry duration (default: 15m)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiry duration (default: 7d)
JWT_REFRESH_EXPIRY=7d

# Enforce MFA for privileged administrative roles ('true' or 'false')
ENFORCE_MFA=false

# 64-character hex key (32 bytes) used to encrypt TOTP secrets in database
MFA_ENCRYPTION_KEY=
MFA_APP_NAME="TBI Platform"

# Enable reCAPTCHA verification on login ('true' or 'false')
CAPTCHA_ENABLED=false

# Google reCAPTCHA v2 site key (optional for local dev)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Inactivity timeout for active user sessions in minutes
SESSION_TIMEOUT_MINUTES=60

# Distributed Redis cache endpoint (optional; in-memory fallback used if unset)
REDIS_CACHE_URL=redis://localhost:6379/0

# Distributed Redis pub/sub endpoint (used for multi-instance socket.io)
REDIS_PUBSUB_URL=redis://localhost:6380/1

# Distributed Redis queue endpoint (used for background workers)
REDIS_QUEUE_URL=redis://localhost:6381/2

# ------------------------------------------------------------------------------
# FRONTEND / VITE SETTINGS (Client-side)
# ------------------------------------------------------------------------------
# Base URL for API requests (leave empty on Vercel to use relative /api rewrites)
VITE_API_BASE_URL=

# Google reCAPTCHA v2 public site key for login page
VITE_RECAPTCHA_SITE_KEY=
