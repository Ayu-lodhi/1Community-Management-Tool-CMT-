{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=@tbi/web",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "apps/web/api/index.js": {
      "includeFiles": "apps/web/server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/apps/web/api/index.js?__url=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
