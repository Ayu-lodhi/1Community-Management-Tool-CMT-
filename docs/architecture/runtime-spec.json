  "cards": [
    {
      "dot": "cyan",
      "title": "Client & Edge Security",
      "items": [
        "Vite React 18 SPA communicates over HTTPS REST and authenticated WebSockets",
        "Security headers (HSTS, CSP, XSS) and Redis rate limiter shield ingress routes",
        "Short-lived JWTs combined with per-user active session tracking enforce fast revocation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Modular Monolith Core",
      "items": [
        "Express API and Socket.io co-located in a single Node.js runtime process",
        "Socket.io gateway verifies JWT auth and applies per-user event rate limiting",
        "Granular RBAC checks role defaults and per-user custom ACCESS_GRANT overrides with Redis caching"
      ]
    },
    {
      "dot": "amber",
      "title": "Tri-Concern Redis Architecture",
      "items": [
        "Dedicated Redis Instance 1 (:6379) manages session blacklists, user activity and write-path cache",
        "Dedicated Redis Instance 2 (:6380) serves as Socket.io pub/sub adapter across nodes",
        "Dedicated Redis Instance 3 (:6381) powers BullMQ distributed job queues with idempotency keys"
      ]
    },
    {
      "dot": "rose",
      "title": "Data Persistence & Cloud Services",
      "items": [
        "MongoDB Atlas cloud replica set (with local Docker rs0 fallback) provides document persistence",
        "BaseRepository encapsulates Mongoose queries with lean, projection, and pagination",
        "BullMQ workers process async email delivery via external SMTP and generate PDF certificates"
      ]
    }
  ]
}
